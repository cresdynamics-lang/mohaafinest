<!-- ===== BLOG INDEX PAGE ===== -->

<!-- Hero Band - Featured Post -->
<section class="blog-hero-band">
    <div class="blog-hero-container">
        <% const featuredPost = blogPosts[0]; %>
        <div class="blog-hero-image">
            <img src="<%= featuredPost.image %>" alt="<%= featuredPost.title %>">
        </div>
        <div class="blog-hero-content">
            <span class="blog-eyebrow">The Mohaa Journal</span>
            <h1><%= featuredPost.title %></h1>
            <p class="blog-hero-excerpt"><%= featuredPost.excerpt %></p>
            <a href="/blog/<%= featuredPost.slug %>" class="blog-cta-pill">Read the Story</a>
        </div>
    </div>
</section>

<!-- Category Filter Pills -->
<section class="blog-filter-section">
    <div class="container">
        <div class="filter-pills">
            <a href="/blog" class="filter-pill <%= !req.query.category ? 'active' : '' %>">All</a>
            <a href="/blog?category=buying-guides" class="filter-pill <%= req.query.category === 'buying-guides' ? 'active' : '' %>" style="background: var(--accent-gold); color: white; border-color: var(--accent-gold);">Buying Guides</a>
            <a href="/blog?category=installation" class="filter-pill <%= req.query.category === 'installation' ? 'active' : '' %>">Installation</a>
            <a href="/blog?category=blackout" class="filter-pill <%= req.query.category === 'blackout' ? 'active' : '' %>">Blackout</a>
            <a href="/blog?category=decor-tips" class="filter-pill <%= req.query.category === 'decor-tips' ? 'active' : '' %>">Décor Tips</a>
            <a href="/blog?category=office" class="filter-pill <%= req.query.category === 'office' ? 'active' : '' %>">Office & Hotel</a>
        </div>
    </div>
</section>

<!-- Alternating Content Blocks -->
<section class="blog-alternating-section">
    <div class="container">
        <% 
        const filteredPosts = req.query.category 
            ? blogPosts.filter(p => p.category === req.query.category)
            : blogPosts.slice(1, 5); // Skip featured, show next 4
        filteredPosts.forEach(function(post, index) {
            const isEven = index % 2 === 0;
        %>
        <div class="blog-alt-block <%= isEven ? 'image-left' : 'image-right' %>">
            <div class="blog-alt-image">
                <img src="<%= post.image %>" alt="<%= post.title %>">
            </div>
            <div class="blog-alt-content">
                <span class="blog-alt-eyebrow"><%= post.category.replace('-', ' ').replace(/\b\w/g, function(l){ return l.toUpperCase() }) %></span>
                <h2><%= post.title %></h2>
                <p class="blog-alt-excerpt"><%= post.excerpt %></p>
                <a href="/blog/<%= post.slug %>" class="blog-alt-cta">Read More <span>→</span></a>
                <% if (post.relatedCollection) { %>
                <span class="blog-collection-tag">Related: <a href="<%= post.relatedCollection %>"><%= post.collectionName %></a></span>
                <% } %>
            </div>
        </div>
        <% }); %>
    </div>
</section>

<!-- Older Posts Grid -->
<section class="blog-older-section">
    <div class="container">
        <h3 class="section-heading">More Articles</h3>
        <div class="blog-compact-grid">
            <% 
            const olderPosts = req.query.category 
                ? blogPosts.filter(p => p.category === req.query.category).slice(5)
                : blogPosts.slice(5);
            olderPosts.forEach(function(post) {
            %>
            <div class="blog-compact-card">
                <a href="/blog/<%= post.slug %>">
                    <img src="<%= post.image %>" alt="<%= post.title %>">
                    <div class="blog-compact-content">
                        <span class="blog-compact-cat"><%= post.category.replace('-', ' ') %></span>
                        <h4><%= post.title %></h4>
                        <span class="blog-compact-time"><%= post.readTime %></span>
                    </div>
                </a>
            </div>
            <% }); %>
        </div>
    </div>
</section>

<!-- Closing CTA Band -->
<section class="blog-cta-band">
    <div class="container">
        <h2>Not sure which curtains are right for you?</h2>
        <p>Chat with us free — our experts will help you find the perfect solution.</p>
        <a href="https://wa.me/<%= phoneIntl %>?text=Hi%20Mohaa%20Finest%20Curtains,%20I%20need%20help%20choosing%20curtains" class="blog-cta-band-btn" target="_blank">
            <span>💬</span> Chat on WhatsApp
        </a>
    </div>
</section>

<style>
/* Blog Hero Band */
.blog-hero-band {
    padding: 80px 0;
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
}

.blog-hero-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
}

.blog-hero-image {
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0,0,0,0.15);
}

.blog-hero-image img {
    width: 100%;
    height: 500px;
    object-fit: cover;
}

.blog-hero-content {
    padding: 20px;
}

.blog-eyebrow {
    display: inline-block;
    background: var(--primary-teal);
    color: white;
    padding: 8px 20px;
    border-radius: 25px;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 20px;
}

.blog-hero-content h1 {
    font-size: 48px;
    line-height: 1.2;
    margin-bottom: 25px;
    color: var(--dark-teal);
    font-family: 'Cinzel', serif;
}

.blog-hero-excerpt {
    font-size: 18px;
    line-height: 1.7;
    color: var(--text-grey);
    margin-bottom: 30px;
}

.blog-cta-pill {
    display: inline-block;
    background: var(--dark-teal);
    color: white;
    padding: 15px 35px;
    border-radius: 30px;
    text-decoration: none;
    font-weight: 600;
    font-size: 16px;
    transition: all 0.3s ease;
}

.blog-cta-pill:hover {
    background: var(--primary-teal);
    transform: translateY(-2px);
    box-shadow: 0 5px 20px rgba(0,0,0,0.2);
}

/* Filter Pills */
.blog-filter-section {
    padding: 40px 0;
    background: white;
}

.filter-pills {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
    justify-content: center;
}

.filter-pill {
    padding: 12px 28px;
    border: 2px solid var(--primary-teal);
    background: white;
    color: var(--primary-teal);
    border-radius: 30px;
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    transition: all 0.3s ease;
}

.filter-pill:hover,
.filter-pill.active {
    background: var(--primary-teal);
    color: white;
}

/* Alternating Blocks */
.blog-alternating-section {
    padding: 80px 0;
}

.blog-alt-block {
    max-width: 1200px;
    margin: 0 auto 80px;
    padding: 0 20px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
}

.blog-alt-block.image-left {
    grid-template-columns: 1fr 1fr;
}

.blog-alt-block.image-right {
    grid-template-columns: 1fr 1fr;
}

.blog-alt-block.image-right .blog-alt-image {
    order: 2;
}

.blog-alt-block.image-right .blog-alt-content {
    order: 1;
}

.blog-alt-image {
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 8px 30px rgba(0,0,0,0.12);
}

.blog-alt-image img {
    width: 100%;
    height: 400px;
    object-fit: cover;
}

.blog-alt-content {
    padding: 20px;
}

.blog-alt-eyebrow {
    display: inline-block;
    background: var(--accent-gold);
    color: white;
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 15px;
}

.blog-alt-content h2 {
    font-size: 36px;
    line-height: 1.3;
    margin-bottom: 20px;
    color: var(--dark-teal);
    font-family: 'Cinzel', serif;
}

.blog-alt-excerpt {
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-grey);
    margin-bottom: 25px;
}

.blog-alt-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--primary-teal);
    text-decoration: none;
    font-weight: 600;
    font-size: 16px;
    transition: all 0.3s ease;
}

.blog-alt-cta:hover {
    gap: 12px;
}

.blog-collection-tag {
    display: block;
    margin-top: 15px;
    font-size: 14px;
    color: #999;
}

.blog-collection-tag a {
    color: var(--primary-teal);
    text-decoration: none;
    font-weight: 500;
}

.blog-collection-tag a:hover {
    text-decoration: underline;
}

/* Older Posts Grid */
.blog-older-section {
    padding: 80px 0;
    background: #f8f9fa;
}

.section-heading {
    text-align: center;
    font-size: 32px;
    color: var(--dark-teal);
    margin-bottom: 40px;
    font-family: 'Cinzel', serif;
}

.blog-compact-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    padding: 0 20px;
}

.blog-compact-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    transition: all 0.3s ease;
}

.blog-compact-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.15);
}

.blog-compact-card a {
    text-decoration: none;
    color: inherit;
}

.blog-compact-card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
}

.blog-compact-content {
    padding: 20px;
}

.blog-compact-cat {
    display: inline-block;
    background: var(--accent-gold);
    color: white;
    padding: 4px 12px;
    border-radius: 15px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    margin-bottom: 10px;
}

.blog-compact-content h4 {
    font-size: 16px;
    margin: 10px 0;
    color: var(--dark-teal);
    line-height: 1.4;
}

.blog-compact-time {
    font-size: 13px;
    color: #999;
}

/* Closing CTA Band */
.blog-cta-band {
    padding: 100px 20px;
    background: linear-gradient(135deg, var(--dark-teal), var(--primary-teal));
    text-align: center;
    color: white;
}

.blog-cta-band h2 {
    font-size: 42px;
    margin-bottom: 20px;
    font-family: 'Cinzel', serif;
}

.blog-cta-band p {
    font-size: 20px;
    margin-bottom: 35px;
    opacity: 0.95;
}

.blog-cta-band-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: white;
    color: var(--primary-teal);
    padding: 18px 40px;
    border-radius: 30px;
    text-decoration: none;
    font-weight: 700;
    font-size: 18px;
    transition: all 0.3s ease;
}

.blog-cta-band-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
}

/* Responsive */
@media (max-width: 992px) {
    .blog-hero-container,
    .blog-alt-block {
        grid-template-columns: 1fr;
        gap: 40px;
    }
    
    .blog-alt-block.image-right .blog-alt-image {
        order: 1;
    }
    
    .blog-alt-block.image-right .blog-alt-content {
        order: 2;
    }
    
    .blog-hero-image img,
    .blog-alt-image img {
        height: 350px;
    }
    
    .blog-hero-content h1 {
        font-size: 36px;
    }
    
    .blog-alt-content h2 {
        font-size: 28px;
    }
    
    .blog-compact-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 768px) {
    .blog-hero-band,
    .blog-alternating-section,
    .blog-older-section {
        padding: 50px 0;
    }
    
    .blog-hero-content h1 {
        font-size: 28px;
    }
    
    .blog-hero-excerpt {
        font-size: 16px;
    }
    
    .blog-cta-band h2 {
        font-size: 32px;
    }
    
    .blog-cta-band p {
        font-size: 16px;
    }
    
    .blog-compact-grid {
        grid-template-columns: 1fr;
    }
    
    .filter-pills {
        gap: 10px;
    }
    
    .filter-pill {
        padding: 10px 20px;
        font-size: 14px;
    }
}
</style>