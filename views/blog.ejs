<script>
// Blog Filter
document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.bf-btn');
    const posts = document.querySelectorAll('#blogGrid .blog-post-card');
    const featCards = document.querySelectorAll('.blog-feat-card');

    filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            const cat = btn.dataset.category;
            filterBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            posts.forEach(p => {
                p.style.display = (cat === 'all' || p.dataset.category === cat) ? 'flex' : 'none';
            });
            featCards.forEach(fc => {
                fc.style.display = (cat === 'all' || fc.dataset.category === cat) ? 'flex' : 'none';
            });
        });
    });
});
</script>