<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <meta name="description" content="<%= description %>">
    <meta name="author" content="Mohaa Finest Curtains">
    <meta name="robots" content="index, follow">
    <meta name="language" content="English">
    <meta name="geo.region" content="KE-30">
    <meta name="geo.placename" content="Eastleigh, Nairobi">
    <meta name="geo.position" content="-1.2767;36.8219">
    <meta name="ICBM" content="-1.2767, 36.8219">
    <meta property="og:title" content="<%= title %>">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:image" content="/images/logo.jpeg">
    <meta property="og:site_name" content="Mohaa Finest Curtains">
    <meta property="og:locale" content="en_KE">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/pages.css">
    <link rel="icon" href="/images/logo.jpeg" type="image/jpeg">
    <style>
        /* Make favicon circular */
        link[rel="icon"] {
            border-radius: 50%;
            -webkit-border-radius: 50%;
            -moz-border-radius: 50%;
        }
    </style>
    <!-- WhatsApp Business API ready -->
    <meta property="business:contact_data:street_address" content="Moyale Mall, Eastleigh">
    <meta property="business:contact_data:locality" content="Nairobi">
    <meta property="business:contact_data:country_name" content="Kenya">
    <meta property="business:contact_data:phone_number" content="<%= phoneIntl %>">
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="nav-container">
            <div class="nav-logo">
                <img src="/images/logo.jpeg" alt="Mohaa Finest Curtains Logo" class="logo">
                <span class="brand-name">Mohaa Finest Curtains</span>
            </div>
            <div class="nav-menu">
                <a href="/" class="nav-link <%= currentPage === 'home' ? 'active' : '' %>">Home</a>
                <a href="/collections" class="nav-link <%= currentPage === 'collections' ? 'active' : '' %>">Collections</a>
                <a href="/services" class="nav-link <%= currentPage === 'services' ? 'active' : '' %>">Services</a>
                <a href="/about" class="nav-link <%= currentPage === 'about' ? 'active' : '' %>">About</a>
                <a href="/blog" class="nav-link <%= currentPage === 'blog' ? 'active' : '' %>">Curtain Tips</a>
                <a href="/how-it-works" class="nav-link <%= currentPage === 'how-it-works' ? 'active' : '' %>">How We Work</a>
                <a href="/gallery" class="nav-link <%= currentPage === 'gallery' ? 'active' : '' %>">Gallery</a>
                <a href="/contact" class="nav-link <%= currentPage === 'contact' ? 'active' : '' %>">Contact</a>
            </div>
            <div class="mobile-menu-toggle">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main>
        <%- body %>
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h3>Mohaa Finest Curtains</h3>
                    <p><strong>Think Curtains. Think Mohaa.</strong></p>
                    <p>Kenya's trusted curtain experts — from measurement to installation nationwide.</p>
                    <p>🏢 Moyale Mall, Eastleigh, Nairobi</p>
                </div>
                <div class="footer-section">
                    <h3>Services</h3>
                    <ul>
                        <li><a href="/services#curtain-sales">Curtain Sales</a></li>
                        <li><a href="/services#free-measurement">Free Measurement</a></li>
                        <li><a href="/services#installation">Professional Installation</a></li>
                        <li><a href="/services#custom">Custom Curtains</a></li>
                        <li><a href="/services#commercial">Office & Hotel Curtains</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h3>Contact</h3>
                    <p>📞 <strong>Phone:</strong> <%= phone %></p>
                    <p>💬 <strong>WhatsApp:</strong> <%= phone %></p>
                    <p>🕒 <strong>Business Hours:</strong></p>
                    <p>Mon-Sat: 8:00 AM - 8:00 PM</p>
                    <p>Sunday: 10:00 AM - 6:00 PM</p>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; <%= new Date().getFullYear() %> Mohaa Finest Curtains. All rights reserved. | Designed by <a href="https://www.cresdynamics.com" target="_blank" style="text-decoration: underline;">Cres Dymics</a></p>
            </div>
        </div>
    </footer>

    <!-- WhatsApp Floating Button -->
    <div class="wa-float-wrapper">
        <div class="wa-popup-bubble" id="waPopupBubble">
            <div class="wa-popup-header">
                <div class="wa-popup-avatar">
                    <img src="/images/logo.jpeg" alt="Mohaa Finest Curtains">
                    <span class="wa-online-dot"></span>
                </div>
                <div class="wa-popup-info">
                    <strong>Mohaa Finest Curtains</strong>
                    <span>Typically replies instantly</span>
                </div>
                <button class="wa-popup-close" id="waPopupClose" aria-label="Close">&times;</button>
            </div>
            <div class="wa-popup-message">
                <div class="wa-chat-bubble">
                    <p>Hi there! 👋 Ready to transform your space with beautiful curtains? Chat with us — it's FREE!</p>
                </div>
            </div>
            <a href="https://wa.me/<%= phoneIntl %>?text=Hi%20Mohaa%20Finest%20Curtains,%20I%20need%20help%20with%20curtains" class="wa-popup-cta" target="_blank" rel="noopener">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.126.557 4.12 1.527 5.845L.057 23.882l6.177-1.447A11.934 11.934 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.794 9.794 0 0 1-5.042-1.396l-.36-.215-3.733.875.944-3.638-.234-.374A9.818 9.818 0 0 1 2.182 12C2.182 6.58 6.58 2.182 12 2.182S21.818 6.58 21.818 12 17.42 21.818 12 21.818z"/></svg>
                Start a conversation
            </a>
        </div>
        <button class="wa-float-btn" id="waFloatBtn" aria-label="Chat on WhatsApp">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" width="28" height="28"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.126.557 4.12 1.527 5.845L.057 23.882l6.177-1.447A11.934 11.934 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.794 9.794 0 0 1-5.042-1.396l-.36-.215-3.733.875.944-3.638-.234-.374A9.818 9.818 0 0 1 2.182 12C2.182 6.58 6.58 2.182 12 2.182S21.818 6.58 21.818 12 17.42 21.818 12 21.818z"/></svg>
            <span class="wa-notification-dot"></span>
        </button>
    </div>

    <script src="/js/script.js"></script>
    <script>
      // WhatsApp Float Button Logic
      const waBtn = document.getElementById('waFloatBtn');
      const waBubble = document.getElementById('waPopupBubble');
      const waClose = document.getElementById('waPopupClose');
      if (waBtn && waBubble) {
        // Auto-show after 3s
        setTimeout(() => { waBubble.classList.add('visible'); }, 3000);
        waBtn.addEventListener('click', () => {
          waBubble.classList.toggle('visible');
        });
        if (waClose) {
          waClose.addEventListener('click', (e) => {
            e.stopPropagation();
            waBubble.classList.remove('visible');
          });
        }
      }
    </script>
</body>
</html>
